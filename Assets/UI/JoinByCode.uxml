<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="JoinByCodeRoot" style="align-items: center; justify-content: center; width: 100%; height: 100%;">
        <ui:VisualElement name="Panel" style="background-color: rgba(0,0,0,0.7); padding: 24px; border-radius: 8px; min-width: 300px;">
            <ui:Label name="Title" text="Join Game" style="font-size: 24px; color: white; -unity-text-align: upper-center; margin-bottom: 16px;"/>
            <ui:TextField name="JoinCodeField" label="" placeholder-text="Enter join code..." style="margin-bottom: 16px;"/>
            <ui:Label name="StatusLabel" text="" style="color: rgb(255,200,100); margin-bottom: 12px; white-space: normal;"/>
            <ui:Button name="JoinButton" text="Join" style="height: 40px; font-size: 16px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
